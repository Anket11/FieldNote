NEXT_PUBLIC_MAPBOX_TOKEN=your_public_mapbox_token
# Public demo location override: longitude,latitude (32.739000 E, 24.456000 N).
NEXT_PUBLIC_BENBAN_COORDINATES=32.739000,24.456000

# Server only. Never use a NEXT_PUBLIC_ prefix for the Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
COPILOTKIT_TELEMETRY_DISABLED=true

# Server only. These credentials must never use NEXT_PUBLIC_.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_SEARCH_INDEX=main.procurement_demo_gold.rag_chunks_backend_index
DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en
DATABRICKS_EMBEDDING_DIMENSION=1024
# Optional; these are the defaults.
DATABRICKS_SILVER_SCHEMA=main.procurement_demo_silver
DATABRICKS_GOLD_SCHEMA=main.procurement_demo_gold
