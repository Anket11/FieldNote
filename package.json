{
  "name": "procurement-intelligence-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import ./scripts/register-css.mjs --import tsx --test src/tests/*.test.ts src/tests/*.test.tsx",
    "check:databricks": "node --import tsx --env-file=.env.local scripts/check-databricks.ts",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm test && npm run test:ui && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.82.0",
    "@copilotkit/runtime": "^1.82.0",
    "@reduxjs/toolkit": "^2.12.0",
    "lucide-react": "0.525.0",
    "next": "16.3.8",
    "parse5": "7.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
